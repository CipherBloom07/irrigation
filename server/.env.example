# Use the connection string for the PostgreSQL instance hosting the scheme registry.
DATABASE_URL=
PORT=5000
# Optional TLS certificate files to serve the API over HTTPS.
# Both must be set together; otherwise server/certs localhost files are used when present.
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
# Optional durable local fallback file used when PostgreSQL is unreachable.
SCHEME_STORE_PATH=

# Set allowed browser origins as comma-separated HTTPS origins in production.
# Production browser requests are denied until this is configured.
CORS_ORIGINS=
# Set to 1 only when the API is behind one trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=0
# Required only for one-time administrator setup; provide a strong random value via the secret manager.
ADMIN_BOOTSTRAP_TOKEN=

# Optional JSON feed endpoints. HTTPS is required; leave blank until provider access is available.
# Telemetry response fields: soil_moisture, water_flow, wind_speed.
TELEMETRY_API_URL=
TELEMETRY_API_TOKEN=
# WeatherAPI current conditions endpoint, e.g. https://api.weatherapi.com/v1/current.json.
# The server supplies the API key, Bulawayo location, and AQI query parameters.
WEATHER_API_URL=
WEATHER_API_KEY=
# The Copernicus catalogue source has a built-in public endpoint and needs no key.
# Copernicus catalogue results are global imagery metadata, not scheme-specific GIS overlays.
# GMB defaults to the official public WordPress announcements API; posts are not structured prices.
# Optionally override its public endpoint.
GMB_API_URL=
# Other weather feed response fields: temperature, rainfall, evapotranspiration, rain_risk,
# monthly_rainfall, monthly_evapotranspiration, monthly_irrigation_demand.
# Satellite response: { "schemes": [{ "code": "...", "coordinates": [...], "source": "..." }] }.
SATELLITE_GIS_API_URL=
SATELLITE_GIS_API_TOKEN=
# Agronomy/market response: { "schemes": [{ "code": "...", "crop": "...", "market": "...", "market_analysis": "..." }] }.
AGRONOMY_API_URL=
AGRONOMY_API_TOKEN=
# The FAOSTAT service could not be verified as reliably available; configure only a documented endpoint.
# World Bank Zimbabwe cereal-yield context uses a built-in public endpoint.
FAO_API_URL=
FAO_API_TOKEN=
WORLD_BANK_API_URL=
WORLD_BANK_API_TOKEN=
